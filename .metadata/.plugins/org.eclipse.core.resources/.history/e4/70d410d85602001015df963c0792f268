#include <stdio.h>
#include "platform.h"
#include "xil_printf.h"
#include "xparameters.h"
#include "xil_io.h"
#include "sleep.h"

// AXI GPIO Adresse aus dem Bild
#define AXI_GPIO_0 0x41200000

int main() {
    init_platform();
    xil_printf("\r\n**********************************\r\n");
    xil_printf("*       AXI GPIO Reader         *\r\n");
    xil_printf("**********************************\r\n");

    while(1) {
        u32 gpio_value = Xil_In32(AXI_GPIO_0); // 32-bit Wert auslesen

        // Snake_x: Bits 23-14 (10 Bit)
        u32 snake_x = (gpio_value >> 14) & 0x3FF;

        // Snake_y: Bits 13-4 (10 Bit)
        u32 snake_y = (gpio_value >> 4) & 0x3FF;

        // Pellet_index: Bits 3-0 (4 Bit)
        u32 pellet_index = gpio_value & 0xF;

        xil_printf("AXI GPIO Wert: 0x%08X\r\n", gpio_value);
        xil_printf("snake_x: %d\r\n", snake_x);
        xil_printf("snake_y: %d\r\n", snake_y);
        xil_printf("pellet_index: %d\r\n", pellet_index);

        usleep(500000); // 500ms warten
    }

    cleanup_platform();
    return 0;
}
